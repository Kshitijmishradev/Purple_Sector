# Point the built frontend at the deployed backend. WS_URL is derived from
# API_URL in src/lib/api.js (https -> wss), so setting API_URL alone is enough.
VITE_API_URL=https://<your-backend-host>

# Seasons the deployment can actually serve. The deployed backend carries only
# the precomputed 2026 season; omit this locally to get the full range.
VITE_SEASONS=2026
