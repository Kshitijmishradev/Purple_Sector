# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_VERSION=v2
LOCK_TIMEOUT=240
WAIT_TIMEOUT=240

# --- Kafka / Redpanda ---
# From your laptop use localhost:19092; inside compose it is redpanda:9092
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC=f1.timing
KAFKA_GROUP=gridlogic-live

# --- FastF1 ---
FASTF1_CACHE_DIR=data_cache

# --- HTTP ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
